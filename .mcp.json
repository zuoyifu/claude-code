{
  "mcpServers": {
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp",
        "--headless",
        "--browser",
        "chromium"
      ]
    },
    "crawl4ai": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "mcp-crawl4ai"]
    },
    "firecrawl-mcp": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "fc-4dd8685ff61548f6a056c23ba127fa88"
      }
    }
  }
}
